// Novedu - Prisma Schema
// Banco: PostgreSQL
// Observação: este schema representa a modelagem inicial do projeto.
// Regras como limites de notas, datas e compatibilidade entre turma/período
// também deverão ser validadas na camada de serviços do backend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT

  @@map("user_role")
}

enum AcademicYearStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("academic_year_status")
}

enum AcademicPeriodStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("academic_period_status")
}

enum ClassGroupStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  CANCELLED

  @@map("class_group_status")
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
  TRANSFERRED
  COMPLETED

  @@map("enrollment_status")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED

  @@map("attendance_status")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(150)
  email     String    @unique @db.VarChar(150)
  password  String    @db.VarChar(255)
  role      UserRole
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  mustChangePassword Boolean @default(true) @map("must_change_password")

  student       Student?
  teacher       Teacher?
  announcements Announcement[]

  @@map("users")
}

model Student {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  registrationNumber String   @unique @map("registration_number") @db.VarChar(30)
  birthDate          DateTime @map("birth_date") @db.Date
  phone              String   @db.VarChar(20)
  address            String   @db.VarChar(255)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollments Enrollment[]

  @@map("students")
}

model Teacher {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @map("user_id") @db.Uuid
  employeeNumber String? @unique @map("employee_number") @db.VarChar(30)
  phone          String? @db.VarChar(20)
  specialty      String? @db.VarChar(100)

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teachingAssignments TeachingAssignment[]

  @@map("teachers")
}

model Subject {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(20)
  description String? @db.Text
  workload    Int

  teachingAssignments TeachingAssignment[]

  @@map("subjects")
}

model AcademicYear {
  id        String             @id @default(uuid()) @db.Uuid
  year      Int                @unique
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    AcademicYearStatus @default(SCHEDULED)

  periods     AcademicPeriod[]
  classGroups ClassGroup[]

  @@map("academic_years")
}

model AcademicPeriod {
  id             String               @id @default(uuid()) @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  quarter        Int
  startDate      DateTime             @map("start_date") @db.Date
  endDate        DateTime             @map("end_date") @db.Date
  status         AcademicPeriodStatus @default(SCHEDULED)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assessments  Assessment[]

  @@unique([academicYearId, quarter])
  @@map("academic_periods")
}

model ClassGroup {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(100)
  academicYearId String           @map("academic_year_id") @db.Uuid
  shift          String           @db.VarChar(20)
  status         ClassGroupStatus @default(ACTIVE)

  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  announcements       Announcement[]

  @@map("class_groups")
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  classGroupId   String           @map("class_group_id") @db.Uuid
  enrollmentDate DateTime         @map("enrollment_date") @db.Date
  status         EnrollmentStatus @default(ACTIVE)

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classGroup  ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grades      Grade[]
  attendances Attendance[]

  @@unique([studentId, classGroupId])
  @@map("enrollments")
}

model TeachingAssignment {
  id           String @id @default(uuid()) @db.Uuid
  teacherId    String @map("teacher_id") @db.Uuid
  subjectId    String @map("subject_id") @db.Uuid
  classGroupId String @map("class_group_id") @db.Uuid

  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classGroup  ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assessments Assessment[]
  attendances Attendance[]

  @@unique([teacherId, subjectId, classGroupId])
  @@map("teaching_assignments")
}

model Assessment {
  id                   String   @id @default(uuid()) @db.Uuid
  teachingAssignmentId String   @map("teaching_assignment_id") @db.Uuid
  academicPeriodId     String   @map("academic_period_id") @db.Uuid
  title                String   @db.VarChar(100)
  assessmentDate       DateTime @map("assessment_date") @db.Date
  maximumScore         Decimal  @map("maximum_score") @db.Decimal(5, 2)
  weight               Decimal  @default(1.00) @db.Decimal(5, 2)

  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicPeriod     AcademicPeriod     @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grades             Grade[]

  @@map("assessments")
}

model Grade {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  score        Decimal  @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([assessmentId, enrollmentId])
  @@map("grades")
}

model Attendance {
  id                   String           @id @default(uuid()) @db.Uuid
  enrollmentId         String           @map("enrollment_id") @db.Uuid
  teachingAssignmentId String           @map("teaching_assignment_id") @db.Uuid
  attendanceDate       DateTime         @map("attendance_date") @db.Date
  status               AttendanceStatus

  enrollment         Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([enrollmentId, teachingAssignmentId, attendanceDate])
  @@map("attendance")
}

model Announcement {
  id           String   @id @default(uuid()) @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  classGroupId String   @map("class_group_id") @db.Uuid
  title        String   @db.VarChar(150)
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  author     User       @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("announcements")
}
